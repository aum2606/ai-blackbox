    "/v1/invocations/{invocation_id}/captures": {
      "post": {
        "description": "Validate and queue a capture; the worker process does the model work.",
        "operationId": "create_capture_v1_invocations__invocation_id__captures_post",
        "parameters": [
          {
            "in": "path",
            "name": "invocation_id",
            "required": true,
            "schema": {
              "title": "Invocation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptureRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureJobOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Capture"
      }
    },
